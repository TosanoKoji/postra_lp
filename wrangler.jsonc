{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postra-lp",
  "main": "_worker.js",
  "compatibility_date": "2026-04-25",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "postra.link/*", "zone_name": "postra.link" },
    { "pattern": "www.postra.link/*", "zone_name": "postra.link" }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": true
  }
}
