{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postra-lp",
  "main": "_worker.js",
  "compatibility_date": "2026-04-25",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": true
  }
}
